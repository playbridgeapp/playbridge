{
  "manifest_version": 3,
  "name": "PlayBridge Video Detector",
  "version": "0.3.0",
  "description": "Detects video URLs for PlayBridge casting",
  "key": "",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "tabs",
    "activeTab",
    "contextMenus",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"]
}
