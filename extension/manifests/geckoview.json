{
  "manifest_version": 2,
  "name": "PlayBridge Media Detector",
  "version": "2.0.0",
  "description": "Detects video, audio, image, and subtitle URLs for PlayBridge casting (GeckoView phone)",
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "storage",
    "tabs",
    "nativeMessaging",
    "geckoViewAddons"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "video-detector@playbridge",
      "strict_min_version": "102.0"
    }
  }
}
