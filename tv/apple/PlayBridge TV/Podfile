platform :tvos, '14.0'

target 'PlayBridge TV' do
  use_frameworks!

  pod 'SwiftProtobuf', '~> 1.28'
  pod 'MPVKit', :podspec => 'https://raw.githubusercontent.com/mpv-ios/MPVKit/0.41.0-av/MPVKit.podspec'


end

post_install do |installer|
  # Rebuild only the pinned AudioUnit object with an unsupported-layout PCM fallback.
  # This preserves the fork's native AVFoundation video/HDR path. Unknown binary or
  # source checksums fail closed; see ../native/mpv-audiounit/README.md.
  patcher = File.expand_path('../native/mpv-audiounit/patch_framework.py', __dir__)
  framework = installer.sandbox.root.join('MPVKit/MPVKit.xcframework')
  cache = installer.sandbox.root.join('MPVKitAudioPatch')
  unless system('python3', patcher, framework.to_s, '--cache', cache.to_s)
    raise 'MPVKit AudioUnit patch failed; refusing an unpatched dependency installation'
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['TVOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end
end
