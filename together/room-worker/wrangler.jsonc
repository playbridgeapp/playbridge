// Room relay for PlayBridge Watch Together. Deploying this file as-is gives a
// self-hosted relay with the full limits. PlayBridge's shared relay deploys
// with `wrangler deploy --env shared`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playbridge-together-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // One log line per refusal and per room problem; no line for every request and message.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITS", "class_name": "Limits" },
      { "name": "GATE", "class_name": "Gate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Limits"] },
    { "tag": "v2", "new_sqlite_classes": ["Gate"] }
  ],
  // Connect limits, counted per Cloudflare location. namespace_id is any integer unique
  // to the account; change them if they clash with another Worker's.
  "ratelimits": [
    { "name": "CONNECTS_PER_ROOM", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    { "name": "CONNECTS_PER_IP", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "SHARED_TIER": "false",
    "MAX_MEMBERS": "8",
    "ROOM_LIFETIME_HOURS": "8",
    "OPEN_ROOMS_PER_IP": "20",
    "ROOMS_PER_IP_PER_HOUR": "100",
    // 0: no daily cap. Set one (e.g. 60000) if this account also runs other Workers.
    "DAILY_BUDGET": "0",
    "IDLE_CLOSE_MINUTES": "30"
  },
  "env": {
    "shared": {
      "name": "playbridge-together-room-shared",
      "routes": [{ "pattern": "party.playbridge.app", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "Room" },
          { "name": "LIMITS", "class_name": "Limits" },
          { "name": "GATE", "class_name": "Gate" }
        ]
      },
      "ratelimits": [
        { "name": "CONNECTS_PER_ROOM", "namespace_id": "4111", "simple": { "limit": 30, "period": 60 } },
        { "name": "CONNECTS_PER_IP", "namespace_id": "4112", "simple": { "limit": 120, "period": 60 } }
      ],
      "vars": {
        "SHARED_TIER": "true",
        "MAX_MEMBERS": "4",
        "ROOM_LIFETIME_HOURS": "3",
        "OPEN_ROOMS_PER_IP": "4",
        "ROOMS_PER_IP_PER_HOUR": "20",
        // 60% of the account's 100,000 free Durable Object requests a day; the rest is
        // left for the pairing service.
        "DAILY_BUDGET": "60000",
        "IDLE_CLOSE_MINUTES": "30",
        // App Links for invite links on party.playbridge.app: the release signing key
        // (GitHub APKs), then the Google Play app-signing key (Play installs).
        "ANDROID_APP_PACKAGE": "com.playbridge.sender",
        "ANDROID_CERT_SHA256": "5C:14:53:AD:22:07:B8:56:2A:7B:54:FE:C9:F4:E7:98:C5:3C:41:5E:A6:C9:05:88:5A:27:07:0A:36:3F:39:F3,CC:A6:19:26:E9:CE:23:99:9B:81:36:72:4B:55:A7:C0:C8:E9:36:DD:5C:FD:92:21:BC:3C:9D:B6:2F:28:14:32",
        "APPLE_APP_IDS": "4VL6AT677Y.app.playbridge.phone"
      }
    }
  }
}
