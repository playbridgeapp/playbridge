<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="atv/credentials.bin"/>
        <exclude domain="file" path="atv/credentials.bin.tmp"/>
        <!-- Watch Together saved parties: their key stays in Android Keystore. -->
        <exclude domain="sharedpref" path="watch_together_saved.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="atv/credentials.bin"/>
        <exclude domain="file" path="atv/credentials.bin.tmp"/>
        <!-- Watch Together saved parties: their key stays in Android Keystore. -->
        <exclude domain="sharedpref" path="watch_together_saved.xml"/>
    </device-transfer>
</data-extraction-rules>
