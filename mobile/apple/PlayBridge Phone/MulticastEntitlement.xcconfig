// Apple granted com.apple.developer.networking.multicast for app.playbridge.phone
// (October 2026). YES signs with config/DLNAMulticast.entitlements and enables
// automatic SSDP (DLNA/Roku/DIAL) discovery on physical iPhones. Pass
// PB_MULTICAST_ENTITLEMENT=NO to xcodebuild for a team or App ID without it.
PB_MULTICAST_ENTITLEMENT = YES

PB_MULTICAST_ENTITLEMENTS_FILE_YES = $(SRCROOT)/../config/DLNAMulticast.entitlements
PB_MULTICAST_CONDITION_YES = PB_MULTICAST_ENTITLED
CODE_SIGN_ENTITLEMENTS = $(PB_MULTICAST_ENTITLEMENTS_FILE_$(PB_MULTICAST_ENTITLEMENT))
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(PB_MULTICAST_CONDITION_$(PB_MULTICAST_ENTITLEMENT))
